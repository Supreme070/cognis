<style data-dc-tpl="5">
  @font-face { font-family: Geistmono; src: url(https://cdn.prod.website-files.com/6929c116366a14507fc8424d/6929c9fc0f8dc4c415a7aef6_GeistMono-Medium.ttf) format("truetype"); font-weight: 400 500; font-style: normal; font-display: swap; }
  html, body { margin: 0; padding: 0; background: #F2F2F2; }
  body { font-family: "Plus Jakarta Sans", -apple-system, "Segoe UI", Roboto, sans-serif; color: #131313; letter-spacing: -0.02em; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: inherit; }
  /* EXPLORE dropdown */
  .cg-exp { position: relative; }
  .cg-exp-panel { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); padding-top: 16px; opacity: 0; visibility: hidden; transition: opacity .22s ease; z-index: 30; }
  .cg-exp:hover .cg-exp-panel, .cg-exp:focus-within .cg-exp-panel { opacity: 1; visibility: visible; }
  .cg-exp-menu { background: #131313; border: 1px solid rgba(255,255,255,0.10); border-radius: 16px; padding: 8px; min-width: 236px; display: flex; flex-direction: column; gap: 2px; box-shadow: 0 28px 60px rgba(0,0,0,0.45); transform: translateY(8px); transition: transform .22s cubic-bezier(.22,1,.36,1); }
  .cg-exp:hover .cg-exp-menu, .cg-exp:focus-within .cg-exp-menu { transform: translateY(0); }
  .cg-exp-menu a { display: flex; flex-direction: column; gap: 2px; padding: 11px 14px; border-radius: 11px; text-transform: none; letter-spacing: -0.01em; transition: background .15s ease; }
  .cg-exp-menu a:hover { background: rgba(255,255,255,0.06); }
  .cg-exp-menu .t { font-weight: 600; font-size: 14px; color: #FFFFFF; }
  .cg-exp-menu .d { font-weight: 400; font-size: 12px; color: rgba(255,255,255,0.5); }

[data-h="h0"]:hover{color: #131313 !important;}
[data-h="h1"]:hover{background: #FFFFFF !important; transform: scale(0.95);}
[data-h="h2"]:hover{opacity: 0.92;}
[data-h="h3"]:hover{transform: translateX(1px);}
[data-h="h4"]:hover{color: #FFFFFF !important;}
[data-h="h5"]:hover{background: #E5FF9B !important;}
a[href*="/blog/"] div[style*="overflow"] img{transition:transform .65s cubic-bezier(.19,1,.22,1)}
a[href*="/blog/"]:hover div[style*="overflow"] img{transform:scale(1.06)}

/* Aeline-style blog cards. Feature card = tpl 43 (img 45, pill 53, text 54,
   circle 55, arrow 56/57); grid cards = tpl 65 (img 67, circle 68, arrow 69). */

/* Lemon arrow circles + text (grid circles were white; match Aeline lemon). */
[data-dc-tpl="55"], [data-dc-tpl="68"] { background: rgb(214, 253, 112) !important; transition: background-color .3s ease; }
[data-dc-tpl="54"] { color: rgb(214, 253, 112); transition: color .3s ease; }

/* Featured image zooms inside its clipped frame. */
a[data-dc-tpl="43"] [data-dc-tpl="45"],
a[data-dc-tpl="65"] [data-dc-tpl="67"] { transition: transform .6s cubic-bezier(.22,1,.36,1); }
a[data-dc-tpl="43"]:hover [data-dc-tpl="45"],
a[data-dc-tpl="65"]:hover [data-dc-tpl="67"] { transform: scale(1.08); }

/* Corner arrow flips diagonal (up-right) -> straight right. */
[data-dc-tpl="56"], [data-dc-tpl="69"] { transition: transform .35s cubic-bezier(.22,1,.36,1); }
a[data-dc-tpl="43"]:hover [data-dc-tpl="56"],
a[data-dc-tpl="65"]:hover [data-dc-tpl="69"] { transform: rotate(45deg); }

/* "Learn More" pill: a lemon fill sweeps in from the right and covers the
   black; text + circle invert to dark so they stay legible on the lemon
   (Aeline's button-arrow fill-reveal). */
[data-dc-tpl="53"] { position: relative; overflow: hidden; }
[data-dc-tpl="53"]::before {
  content: ""; position: absolute; inset: 0; background: rgb(214, 253, 112);
  border-radius: inherit; transform: translateX(102%);
  transition: transform .5s cubic-bezier(.22,1,.36,1); z-index: 0;
}
[data-dc-tpl="54"], [data-dc-tpl="55"] { position: relative; z-index: 1; }
[data-dc-tpl="57"] { transition: fill .3s ease; }
a[data-dc-tpl="43"]:hover [data-dc-tpl="53"]::before { transform: translateX(0); }
a[data-dc-tpl="43"]:hover [data-dc-tpl="54"] { color: #131313 !important; }
a[data-dc-tpl="43"]:hover [data-dc-tpl="55"] { background: #131313 !important; }
a[data-dc-tpl="43"]:hover [data-dc-tpl="57"] { fill: rgb(214, 253, 112); }

/* keep the grid card from flat-dimming so the zoom reads clean */
a[data-dc-tpl="65"]:hover { opacity: 1; }
</style>
