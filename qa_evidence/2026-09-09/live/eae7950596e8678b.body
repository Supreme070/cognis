    <!-- a11y contrast override (WCAG 2.2 AA). Darkens the FaunaFlora template
         grays that fail 4.5:1 on light surfaces. Override-only; never edits
         tailwind.min.css (root + marketing CLAUDE.md lock). -->
    <style>
      /* Migratio brand override (Stage 6.3 pattern — tailwind.min.css untouched).
         Remap the FaunaFlora teal/lime template classes to the LOCKED Migratio
         palette so no FaunaFlora green-energy color renders on this page. */
      .bg-teal-900 { background-color: #1F2657 !important; }
      .text-teal-900 { color: #1F2657 !important; }
      .text-teal-800 { color: #1F2657 !important; }
      .border-teal-900 { border-color: #1F2657 !important; }
      .hover\:text-teal-700:hover { color: #1F2657 !important; }
      .hover\:bg-teal-900:hover { background-color: #1F2657 !important; }
      .bg-lime-500 { background-color: #5BB04F !important; }
      .text-lime-500 { color: #5BB04F !important; }
      .border-lime-500 { border-color: #5BB04F !important; }
      .hover\:text-lime-500:hover { color: #5BB04F !important; }
      .bg-orange-50 { background-color: #F8F8F3 !important; }
      /* a11y contrast (WCAG 2.2 AA): template grays fail on light surfaces. */
      .text-gray-500 { color: #5f6664 !important; }
      .text-gray-600 { color: #565c5b !important; }
    </style>
