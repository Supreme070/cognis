<style>
  :root {
    --ink: #131313;
    --ink-soft: #2f2f2f;
    --mute: #7b7b7b;
    --line: #e6e6e6;
    --bg: #f2f2f2;
    --card: #ffffff;
    --accent: #cdfb56;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--ink);
    background: var(--bg);
    font-size: 17px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  header.site-nav {
    position: sticky; top: 0; z-index: 10;
    background: rgba(242, 242, 242, 0.92);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  header.site-nav .inner {
    max-width: 1100px; margin: 0 auto;
    padding: 18px 24px;
    display: flex; align-items: center; justify-content: space-between;
  }
  header.site-nav a.brand {
    font-weight: 700; letter-spacing: -0.01em; color: var(--ink); text-decoration: none;
    font-size: 20px;
  }
  header.site-nav nav a {
    color: var(--ink-soft); text-decoration: none; margin-left: 24px; font-weight: 500; font-size: 15px;
  }
  header.site-nav nav a:hover { color: var(--ink); }
  main.faq {
    max-width: 820px; margin: 0 auto;
    padding: 64px 24px 96px;
  }
  main.faq h1 {
    font-size: 48px; line-height: 1.08; letter-spacing: -0.02em;
    margin: 0 0 12px; font-weight: 700;
  }
  main.faq .lead {
    color: var(--ink-soft); font-size: 19px; line-height: 1.55;
    margin: 0 0 48px; max-width: 680px;
  }
  main.faq h2 {
    font-size: 15px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--mute); font-weight: 600;
    margin: 48px 0 12px;
  }
  main.faq details {
    border-top: 1px solid var(--line);
    padding: 20px 0;
  }
  main.faq details:last-of-type { border-bottom: 1px solid var(--line); }
  main.faq details summary {
    cursor: pointer; font-weight: 600; font-size: 18px;
    list-style: none; position: relative; padding-right: 32px;
    color: var(--ink);
  }
  main.faq details summary::-webkit-details-marker { display: none; }
  main.faq details summary::after {
    content: "+"; position: absolute; right: 0; top: -2px;
    font-size: 26px; font-weight: 400; color: var(--mute);
  }
  main.faq details[open] summary::after { content: "−"; }
  main.faq details p {
    margin: 14px 0 0; color: var(--ink-soft);
  }
  main.faq details a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  main.faq details a:hover { background: var(--accent); }
  main.faq .cta {
    margin-top: 64px; padding: 32px;
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
  }
  main.faq .cta h3 { margin: 0 0 8px; font-size: 20px; font-weight: 700; }
  main.faq .cta p { margin: 0 0 16px; color: var(--ink-soft); }
  main.faq .cta a {
    display: inline-block; background: var(--ink); color: #fff;
    padding: 12px 22px; border-radius: 8px; text-decoration: none; font-weight: 600;
  }
  main.faq .cta a:hover { background: var(--accent); color: var(--ink); }
  footer.site-foot {
    border-top: 1px solid var(--line); background: #0A0A0A; color: #C1C1C1;
    padding: 40px 24px; font-size: 14px;
  }
  footer.site-foot .inner {
    max-width: 1100px; margin: 0 auto;
    display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between;
  }
  footer.site-foot a { color: #C1C1C1; text-decoration: none; margin-right: 18px; }
  footer.site-foot a:hover { color: var(--accent); }
  footer.site-foot .legal-links a { margin-right: 16px; }
</style>
