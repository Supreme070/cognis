<script data-cognis-copy>
(function () {
  var REPL = {"think smarter, move faster, and grow stronger": "ship AI into production and operate it with confidence", "forward-thinking organisations to operationalise AI": "banks, ministries, and enterprises to put AI into production \u2014 and govern it"};
  function fix() {
    var ps = document.querySelectorAll('p');
