<style>
  :root {
    --ink: #131313;
    --ink-soft: #2f2f2f;
    --mute: #7b7b7b;
    --line: #e6e6e6;
    --bg: #f2f2f2;
    --card: #ffffff;
    --accent: #cdfb56;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--ink);
    background: var(--bg);
    font-size: 17px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  header.site-nav {
    position: sticky; top: 0; z-index: 10;
    background: rgba(242, 242, 242, 0.92);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  header.site-nav .inner {
    max-width: 1100px; margin: 0 auto;
    padding: 18px 24px;
    display: flex; align-items: center; justify-content: space-between;
  }
  header.site-nav a.brand {
    font-weight: 700; letter-spacing: -0.01em; color: var(--ink); text-decoration: none;
    font-size: 20px;
  }
  header.site-nav nav a {
    color: var(--ink-soft); text-decoration: none; margin-left: 24px; font-weight: 500; font-size: 15px;
  }
  header.site-nav nav a:hover { color: var(--ink); }
  main.legal {
    max-width: 760px; margin: 0 auto;
    padding: 64px 24px 96px;
  }
  main.legal h1 {
    font-size: 44px; line-height: 1.1; letter-spacing: -0.02em;
    margin: 0 0 8px; font-weight: 700;
  }
  main.legal .meta { color: var(--mute); font-size: 15px; margin: 0 0 40px; }
  main.legal h2 {
    font-size: 22px; letter-spacing: -0.01em;
    margin: 40px 0 12px; font-weight: 600;
  }
  main.legal h3 {
    font-size: 18px; margin: 28px 0 10px; font-weight: 600;
  }
  main.legal p { margin: 0 0 16px; }
  main.legal ul { padding-left: 22px; margin: 0 0 16px; }
  main.legal li { margin-bottom: 6px; }
  main.legal a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  main.legal a:hover { background: var(--accent); }
  footer.site-foot {
    border-top: 1px solid var(--line); background: #0A0A0A; color: #C1C1C1;
    padding: 40px 24px; font-size: 14px;
  }
  footer.site-foot .inner {
    max-width: 1100px; margin: 0 auto;
    display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between;
  }
  footer.site-foot a { color: #C1C1C1; text-decoration: none; margin-right: 18px; }
  footer.site-foot a:hover { color: var(--accent); }
  footer.site-foot .legal-links a { margin-right: 16px; }
</style>
