<!DOCTYPE html>
<html class="no-js" lang="en">
<head>

    <meta charset="utf-8">
    <title>MarketSage — Coming Soon</title>
    <meta name="description" content="MarketSage is launching soon. AI-powered marketing automation built for Africa.">
    <meta name="robots" content="noindex">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta property="og:title" content="MarketSage — Coming Soon">
    <meta property="og:description" content="AI-powered marketing automation built for Africa. Launching soon.">
    <meta property="og:type" content="website">

    <!-- CSS -->
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="css/vendor.css">
    <link rel="stylesheet" href="css/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- brand overrides: light theme + MarketSage colors (loaded last) -->
    <link rel="stylesheet" href="css/custom.css">

    <script src="js/modernizr.js"></script>
    <script src="js/pace.min.js"></script>

    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
    <link rel="icon" href="favicon.ico" type="image/x-icon">

</head>

<body>

    <!-- home -->
    <main class="s-home s-home--particles">

        <div id="particles-js" class="home-particles"></div>

        <div class="gradient-overlay"></div>

        <div class="home-content">

            <div class="home-logo">
                <a href="/">
                    <img src="images/logo.png" alt="MarketSage Africa">
                </a>
            </div>

            <div class="row home-content__main">

                <div class="col-eight home-content__text pull-right">
                    <h3>MarketSage Africa</h3>

                    <h1>
                    Something big is <br>
                    on the way.
                    </h1>

                    <p>
                    We're putting the finishing touches on AI-powered marketing
                    automation built for Africa &mdash; campaigns, contacts, and
                    intelligent workflows in one place. Sign-ups open very soon.
                    </p>

                    <div class="home-content__subscribe">
                        <form id="mc-form" class="group" action="mailto:hello@marketsage.africa" method="get" novalidate="true">
                            <input type="email" value="" name="EMAIL" class="email" id="mc-email" placeholder="Email Address" required="">
                            <input type="submit" name="subscribe" value="Notify Me">
                            <label for="mc-email" class="subscribe-message"></label>
                        </form>
                    </div>
                </div>  <!-- end home-content__text -->

                <div class="col-four home-content__counter">
                    <h3>Launching In</h3>

                    <div class="home-content__clock">
                        <div class="top">
                            <div class="time days">
                                34
                                <span>Days</span>
                            </div>
                        </div>
                        <div class="time hours">
                            00
                            <span>H</span>
                        </div>
                        <div class="time minutes">
                            00
                            <span>M</span>
                        </div>
                        <div class="time seconds">
                            00
                            <span>S</span>
                        </div>
                    </div>  <!-- end home-content__clock -->
                </div>  <!-- end home-content__counter -->

            </div>  <!-- end home-content__main -->

            <ul class="home-social">
                <li>
                <a href="https://www.linkedin.com/company/marketsage-africa" target="_blank" rel="noopener"><i class="fab fa-linkedin-in" aria-hidden="true"></i><span>LinkedIn</span></a>
                </li>
                <li>
                <a href="https://x.com/marketsageafrica" target="_blank" rel="noopener"><i class="fab fa-twitter" aria-hidden="true"></i><span>X</span></a>
                </li>
                <li>
                <a href="https://www.instagram.com/marketsageafrica" target="_blank" rel="noopener"><i class="fab fa-instagram" aria-hidden="true"></i><span>Instagram</span></a>
                </li>
                <li>
                <a href="mailto:hello@marketsage.africa"><i class="fas fa-envelope" aria-hidden="true"></i><span>Email</span></a>
                </li>
            </ul> <!-- end home-social -->

            <div class="row home-copyright">
                <span>&copy; MarketSage Africa 2024</span>
                <span><a href="mailto:hello@marketsage.africa">hello@marketsage.africa</a></span>
            </div> <!-- end home-copyright -->

            <div class="home-content__line"></div>

        </div> <!-- end home-content -->

    </main> <!-- end s-home -->


    <!-- preloader -->
    <div id="preloader">
        <div id="loader">
            <div class="line-scale-pulse-out">
                <div></div>
                <div></div>
                <div></div>
                <div></div>
                <div></div>
            </div>
        </div>
    </div>

    <!-- Java Script -->
    <script src="js/jquery-3.2.1.min.js"></script>
    <script src="js/plugins.js"></script>
    <script src="js/polygons.js"></script>
    <script src="js/main.js"></script>

<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a374ca09bc996559',t:'MTc4ODc3NDQxNg=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>

</html>
