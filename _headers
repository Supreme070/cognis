# Cloudflare Pages response headers.
# HTML and mutable assets revalidate so deployments appear immediately.
# Some legacy JS filenames look hashed but are patched in place by the CMS
# build. Do not mark those bundles immutable without true fingerprinting.

# Keep Cloudflare aliases out of search results; canonical HTML points to
# cognis.group. Domain redirects can additionally be configured in the account.
https://cognis.pages.dev/*
  X-Robots-Tag: noindex
https://:version.cognis.pages.dev/*
  X-Robots-Tag: noindex

# Legacy image directory also contains mutable human-readable filenames.
/framer-runtime/images/*
  Cache-Control: public, max-age=0, must-revalidate

# Runtime media and fonts may keep human-readable filenames and can be
# replaced in place; revalidate them so deployments cannot strand stale files.
/framer-runtime/assets/*
  Cache-Control: public, max-age=0, must-revalidate
/framer-runtime/fonts/*
  Cache-Control: public, max-age=0, must-revalidate

# Locally-served product assets (not fingerprinted, replaced in place during
# redesigns) — always revalidate so a deploy shows immediately; unchanged
# files still answer with a cheap 304 via ETag.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# Brand icons (not fingerprinted) — a week.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800

# CMS chunks change on every content rebuild and are not fingerprinted —
# keep these short so edits surface quickly.
/cognis-cms/*
  Cache-Control: public, max-age=3600, must-revalidate

# Security headers for all responses (defensive hardening).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
