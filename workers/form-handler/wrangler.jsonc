{
	"name": "cognis-form-handler",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",
	"routes": [
		{
			"pattern": "cognis.group/api/*",
			"zone_name": "cognis.group"
		},
		{
			"pattern": "www.cognis.group/api/*",
			"zone_name": "cognis.group"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"triggers": {
		"crons": ["0 7 * * 1", "15 * * * *"]
	},
	"ratelimits": [
		{ "name": "ASK_RL", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
		{ "name": "FORM_RL", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
	],
	"vars": {
		"TURNSTILE_SITEKEY": "0x4AAAAAAEt_895eebFcoMJF",
		"ASK_MODEL": ""
	},
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["forms@cognis.group", "noreply@cognis.group"]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cognis-leads",
			"database_id": "2d1e0f2e-191d-4bd2-8029-0c7b63dea82d"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"workflows": [
		{
			"name": "lead-enrichment",
			"binding": "FORM_WORKFLOW",
			"class_name": "LeadEnrichment"
		}
	],
	"ai_search": [
		{
			"binding": "SITE_SEARCH",
			"instance_name": "cognis-site",
			"remote": true
		}
	]
}
